{
  "buildCommand": "cd client && npm ci && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm ci && cd client && npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/driver-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/email-outbox",
      "schedule": "0 7 * * *"
    }
  ]
}
