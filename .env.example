# Production env (set these in Vercel Project → Settings → Environment Variables)
# Yoco works without committing keys — host env is required.

YOCO_SECRET_KEY=
NEXT_PUBLIC_YOCO_PUBLIC_KEY=
SITE_URL=https://your-domain.vercel.app

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client Vite auth (also set in client/.env for local `npm run dev`)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Break-glass PIN. Leave empty unless you set a long random value in the host env.
DRIVER_PIN=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET on scheduled calls to /api/cron.
# Required. Requests without this header are rejected, including ones that only set x-vercel-cron.
CRON_SECRET=

# Booking notifications (guest, driver, ops). Verify this sender in MailerSend.
# Do not use Resend. Auth emails (signup, password reset) stay on Supabase until
# the same MailerSend account is set as custom SMTP in the Supabase dashboard.
MAILERSEND_API_KEY=
EMAIL_FROM=KhayrCape Experiences <hello.khayrcapeexperiences@gmail.com>
# Optional: separate admin PIN for legacy API fallback (prefer Supabase Auth admin role)
# ADMIN_PIN=
# Booking notify emails (pending + paid) go to the driver inbox
DRIVER_NOTIFY_EMAIL=yaseenjacobs@icloud.com

# Operator Auth accounts (create via scripts/seed-operator-auth-users.mjs — do not commit passwords):
#   Admin:  yaseenjacobs97@gmail.com
#   Driver: yaseenjacobs@icloud.com
# OPERATOR_ADMIN_PASSWORD=
# OPERATOR_DRIVER_PASSWORD=

# Test auth seed (scripts/seed-test-auth-users.mjs — DO NOT run against production):
# SEED_ALLOW_RUN=
# SEED_ADMIN_PASSWORD=
# SEED_DRIVER_PASSWORD=
# SEED_CLIENT_PASSWORD=

# Unused by the booking outbox. Booking mail is MailerSend (MAILERSEND_API_KEY / EMAIL_FROM).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yaseenjacobs97@gmail.com
SMTP_PASS=
SMTP_FROM=KhayrCape Experiences <yaseenjacobs97@gmail.com>

# Optional local/dev-only in-memory store (NOT durable on Vercel)
# BOOKING_MOCK=1
