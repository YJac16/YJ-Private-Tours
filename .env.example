# Production env (set these in Vercel Project → Settings → Environment Variables)
# Yoco works without committing keys — host env is required.

YOCO_SECRET_KEY=
NEXT_PUBLIC_YOCO_PUBLIC_KEY=
SITE_URL=https://your-domain.vercel.app

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client Vite auth (also set in client/.env for local `npm run dev`)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

DRIVER_PIN=0420
# Optional: separate admin PIN for legacy API fallback (prefer Supabase Auth admin role)
# ADMIN_PIN=
# Booking notify emails (pending + paid) go to the driver inbox
DRIVER_NOTIFY_EMAIL=yaseenjacobs@icloud.com

# Operator Auth accounts (create via scripts/seed-operator-auth-users.mjs — do not commit passwords):
#   Admin:  yaseenjacobs97@gmail.com
#   Driver: yaseenjacobs@icloud.com
# OPERATOR_ADMIN_PASSWORD=
# OPERATOR_DRIVER_PASSWORD=

# Transactional email (Brevo — booking guest + driver notifications via /api/email-outbox)
# Set BREVO_API_KEY in Vercel (production + preview). Do not commit real keys.
BREVO_API_KEY=
# Optional sender override (default hello@khayrcapeexperiences.com)
# BREVO_FROM_EMAIL=hello@khayrcapeexperiences.com
# BREVO_FROM_NAME=KhayrCape Bookings

# Optional local/dev-only in-memory store (NOT durable on Vercel)
# BOOKING_MOCK=1
