# Copy to .env and fill in your values
PORT=5000
FRONTEND_URL=http://localhost:5173
BUSINESS_EMAIL=your-business@example.com

# Yoco payment gateway — use test keys for dev, live for production
# Test: sk_test_...  Live: sk_live_...
YOCO_SECRET_KEY=sk_test_your_secret_key

# SMTP (Nodemailer) — use real values for production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KhayrCape Experiences <noreply@example.com>
