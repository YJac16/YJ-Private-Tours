# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Yoco Online Payments
YOCO_SECRET_KEY=sk_live_or_test_secret
NEXT_PUBLIC_YOCO_PUBLIC_KEY=pk_live_or_test_public
SITE_URL=http://localhost:5173

# Driver portal
# Optional break-glass PIN for legacy Next /api/driver only — no default.
# Production uses Supabase Auth JWT via the Vite app `/driver` → `/api/driver`.
# DRIVER_PIN=
DRIVER_NOTIFY_EMAIL=yaseenjacobs@icloud.com

# Transactional email (Brevo — booking guest + driver notifications)
# Set BREVO_API_KEY in Vercel Project → Settings → Environment Variables (Yaseen).
BREVO_API_KEY=
# Optional sender override (domain must be authenticated in Brevo)
# BREVO_FROM_EMAIL=hello@khayrcapeexperiences.com
# BREVO_FROM_NAME=KhayrCape Bookings

# BOOKING_MOCK=1
